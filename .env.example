# Copy to .env (git-ignored) and fill in. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=change-me
DEEPTRACE_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Optional: download the model bundle from the Hugging Face Hub instead of ./models/current
DEEPTRACE_MODEL_REPO_ID=
DEEPTRACE_MODEL_REVISION=main

# Optional overrides
DEEPTRACE_RATE_LIMIT_REQUESTS=10
DEEPTRACE_RETENTION_DAYS=30
# MODEL_HOST_DIR=./models
