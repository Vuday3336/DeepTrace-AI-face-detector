# Single-container image for Hugging Face Spaces (free CPU Space, Docker SDK).
# FastAPI serves the API and the built React app on port 7860; history is disabled (no database).
# The deploy workflow copies this file to `Dockerfile` in the Space repo.

FROM node:22-alpine AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

# Spaces run containers as uid 1000
RUN useradd --create-home --uid 1000 user
WORKDIR /home/user/app

COPY backend/requirements-torch.txt ./
RUN pip install -r requirements-torch.txt --index-url https://download.pytorch.org/whl/cpu \
 && pip install facenet-pytorch==2.6.0 --no-deps
COPY backend/requirements.txt ./
RUN pip install -r requirements.txt

COPY ml/pyproject.toml ml/pyproject.toml
COPY ml/src ml/src
RUN pip install ./ml --no-deps
COPY backend/app app
COPY --from=frontend /build/dist frontend

RUN mkdir -p models && chown -R user /home/user
USER user

# Model: set DEEPTRACE_MODEL_REPO_ID (and pin DEEPTRACE_MODEL_REVISION) as Space variables.
ENV DEEPTRACE_MODEL_DIR=/home/user/app/models/current \
    DEEPTRACE_FRONTEND_DIR=/home/user/app/frontend \
    DEEPTRACE_TRUST_FORWARDED_FOR=true \
    DEEPTRACE_ONNX_THREADS=2 \
    DEEPTRACE_CORS_ORIGINS='[]' \
    HOME=/home/user
EXPOSE 7860
CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "7860", "--proxy-headers", "--forwarded-allow-ips", "*"]
